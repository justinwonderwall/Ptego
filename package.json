    "better-sqlite3": "^13.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.3",
    "mammoth": "^1.12.2",
    "multer": "^2.0.1",
    "openai": "^7.8.0",
    "pdf-parse": "^2.4.5"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
